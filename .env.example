# Configuración para DAROX Lead Engine
# Clave API de Google Places (Requerida para el Módulo 3)
GOOGLE_PLACES_API_KEY=

# Provincias prioritarias para BORME (separadas por comas, o vacio para todas)
# Ejemplos: MADRID, BARCELONA, VALENCIA, SEVILLA, MALAGA, ALICANTE, BIZKAIA
BORME_PROVINCES=MADRID,BARCELONA,VALENCIA

# Configuración de base de datos SQLite para Google Maps
DB_PATH=data/places_store.db

# Configuración de exportación CSV
CSV_BORME_OUTPUT=data/leads_borme_enriquecidos.csv
CSV_PLACES_OUTPUT=data/leads_google_places.csv

